#!/bin/bash
# Runs as root after the .pkg puts Qalam in /Applications and /Library/Input Methods.
user=$(stat -f%Su /dev/console)
home=$(dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')

# Keep a single copy: remove a per-user install from Homebrew or install.sh, if any.
if [ -n "$home" ]; then
  rm -rf "$home/Library/Input Methods/QalamInput.app" "$home/Applications/Qalam.app"
fi

# Fonts for every app (Pages, Word…): SIL Scheherazade New, and KFGQPC Hafs when it's included.
if [ -n "$home" ] && [ "$user" != "root" ]; then
  sudo -u "$user" mkdir -p "$home/Library/Fonts"
  for f in /Applications/Qalam.app/Contents/Resources/Fonts/ScheherazadeNew*.ttf /Applications/Qalam.app/Contents/Resources/Fonts/*KFGQPC*.ttf /Applications/Qalam.app/Contents/Resources/Fonts/*Hafs*.ttf; do
    [ -f "$f" ] && [ ! -f "$home/Library/Fonts/$(basename "$f")" ] && sudo -u "$user" cp "$f" "$home/Library/Fonts/"
  done
fi

# Restart the keyboard so the new version is used, and refresh the input menu.
killall QalamInput 2>/dev/null || true
[ -n "$user" ] && pkill -u "$user" TextInputMenuAgent 2>/dev/null || true

# Open the app for the person at the screen: it walks them through setup and practice.
if [ -n "$user" ] && [ "$user" != "root" ]; then
  sudo -u "$user" open "/Applications/Qalam.app" || true
fi
exit 0
