<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The updater installs a new .pkg with "do shell script … with administrator privileges".
	     Only needed once the app is signed with the hardened runtime (Developer ID builds). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
