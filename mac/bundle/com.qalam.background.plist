<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Starts Qalam hidden at login (menu bar only), so ⌃⇧Q opens the Qur'an box in any app.
	     Registered by the app with SMAppService (Settings → "Keep Qalam running"). -->
	<key>Label</key>
	<string>com.qalam.background</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/Qalam</string>
	<key>ProgramArguments</key>
	<array>
		<string>Contents/MacOS/Qalam</string>
		<string>--background</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
